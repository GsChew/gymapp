# Local-only test infrastructure. Values below are disposable development
# credentials and must not be reused outside the test stack.
TEST_DATABASE_URL=postgresql+asyncpg://gym_test:gym_test@127.0.0.1:55432/gymapp_test
TEST_ALEMBIC_DATABASE_URL=postgresql+psycopg://gym_test:gym_test@127.0.0.1:55432/gymapp_test
TEST_REDIS_URL=redis://127.0.0.1:56379/0
TEST_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:55672//
TEST_API_TIMEOUT=5
REQUIRE_TEST_INFRA=0
UI_HEADLESS=1

# Optional for Docker or a custom local Chromium installation.
# UI_BROWSER_BINARY=/usr/bin/chromium
# UI_DRIVER_BINARY=/usr/bin/chromedriver

# Required because application settings are loaded during import.
DATABASE_URL=postgresql+asyncpg://gym_test:gym_test@127.0.0.1:55432/gymapp_test
ALEMBIC_DATABASE_URL=postgresql+psycopg://gym_test:gym_test@127.0.0.1:55432/gymapp_test
SECRET_KEY=replace-with-a-long-test-only-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CELERY_BROKER_URL=amqp://guest:guest@127.0.0.1:55672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:56379/1
REDIS_URL=redis://127.0.0.1:56379/0
LOG_LEVEL=WARNING
LOG_DIR=/tmp/gymapp-test-logs
LOG_JSON=false
